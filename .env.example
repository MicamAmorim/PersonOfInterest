# PersonOfInterest V5
POI_PORT=8080
TZ=America/Bahia

# Backend -> go2rtc (internal Docker network)
GO2RTC_API_URL=http://go2rtc:1984

# Tonho -> SearXNG local (internal Docker network)
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=personofinterest-local-search
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_RESULT_COUNT=5

# Optional: URL shown in API metadata. The frontend normally uses /go2rtc via Caddy.
PUBLIC_BASE_URL=http://localhost:8080
